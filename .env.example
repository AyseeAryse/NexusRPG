# ===========================================
# ФАЙЛ ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# ===========================================
# Скопируйте этот файл в .env и заполните значениями
# cp .env.example .env

# ===========================================
# AI БЭКЕНДЫ
# ===========================================

# OpenAI API Key (для GPT-моделей)
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (для Claude)
# Получить: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI API Key (для Gemini)
# Получить: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ===========================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ===========================================

# Режим отладки (True для разработки, False для продакшена)
DEBUG=False

# Хост сервера
HOST=0.0.0.0

# Порт сервера
PORT=5000

# ===========================================
# AI КОНФИГУРАЦИЯ
# ===========================================

# AI бэкенд по умолчанию: ollama, lmstudio, openai, anthropic, google
DEFAULT_AI_BACKEND=ollama

# Модель по умолчанию
DEFAULT_MODEL=llama3.2

# Адрес Ollama сервера
OLLAMA_BASE_URL=http://localhost:11434

# Адрес LMStudio сервера
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Максимальное количество токенов в ответе
MAX_TOKENS=2048

# Температура генерации (0.0 - 1.0)
TEMPERATURE=0.7
