/* ============================================================
   NEXUS RPG — Styles v2
   ============================================================ */

/* ---- Reset & Base ---- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg: #0a0a0f;
    --bg2: #12121a;
    --bg3: #1a1a28;
    --bg4: #22223a;
    --cyan: #00f0ff;
    --magenta: #ff00aa;
    --gold: #ffd700;
    --green: #00ff88;
    --red: #ff3355;
    --text: #e0e0e8;
    --text2: #8888a0;
    --border: #2a2a40;
    --font-display: 'Orbitron', sans-serif;
    --font-mono: 'Fira Code', monospace;
    --font-body: 'Noto Sans', sans-serif;
}

html, body {
    height: 100%; width: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    overflow: hidden;
}

/* ---- Scrollbar ---- */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg2); }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--cyan); }

/* ---- Screens ---- */
.screen { display: none; width: 100%; height: 100%; position: absolute; top: 0; left: 0; }
.screen.active { display: flex; flex-direction: column; }

/* ---- Buttons ---- */
.btn {
    background: var(--bg3); color: var(--text); border: 1px solid var(--border);
    padding: 8px 16px; font-family: var(--font-mono); font-size: 13px;
    cursor: pointer; transition: all 0.2s; border-radius: 4px;
}
.btn:hover { border-color: var(--cyan); color: var(--cyan); }
.btn-primary { border-color: var(--cyan); color: var(--cyan); background: rgba(0,240,255,0.08); }
.btn-primary:hover { background: rgba(0,240,255,0.2); box-shadow: 0 0 15px rgba(0,240,255,0.2); }
.btn-lg { padding: 12px 24px; font-size: 15px; }
.btn-sm { padding: 4px 10px; font-size: 11px; }
.btn-block { display: block; width: 100%; margin-bottom: 10px; }
.btn:disabled { opacity: 0.3; cursor: not-allowed; }
.btn-send {
    background: linear-gradient(135deg, var(--cyan), var(--magenta));
    border: none; color: #fff; font-size: 18px;
    width: 48px; height: 48px; border-radius: 8px; cursor: pointer;
    flex-shrink: 0;
}
.btn-send:hover { opacity: 0.9; transform: scale(1.05); }

/* ---- Inputs ---- */
.inp {
    background: var(--bg2); color: var(--text); border: 1px solid var(--border);
    padding: 8px 12px; font-family: var(--font-mono); font-size: 13px;
    border-radius: 4px; width: 100%;
}
.inp:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 8px rgba(0,240,255,0.15); }
.inp-select {
    background: var(--bg2); color: var(--text); border: 1px solid var(--border);
    padding: 8px 12px; font-family: var(--font-mono); font-size: 13px;
    border-radius: 4px; flex: 1; appearance: auto;
}
.inp-select option { background: var(--bg2); color: var(--text); }
.inp-textarea { resize: vertical; min-height: 60px; font-family: var(--font-body); }
.inp-range { width: 100%; accent-color: var(--cyan); }
.model-select-row { display: flex; gap: 8px; align-items: center; }

/* ---- Glitch ---- */
.glitch {
    font-family: var(--font-display); text-shadow: 0 0 20px var(--cyan), 0 0 40px rgba(0,240,255,0.3);
    animation: glitch 3s infinite;
}
@keyframes glitch {
    0%, 95%, 100% { text-shadow: 0 0 20px var(--cyan); }
    96% { text-shadow: -3px 0 var(--magenta), 3px 0 var(--cyan); }
    97% { text-shadow: 3px 0 var(--magenta), -3px 0 var(--cyan); }
}

/* ---- Loading ---- */
#loading-overlay {
    position: fixed; z-index: 999; inset: 0;
    background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center;
}
.hidden { display: none !important; }
.loading-spinner {
    width: 50px; height: 50px; border: 3px solid var(--border);
    border-top-color: var(--cyan); border-radius: 50%; animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ============================================================
   BOOT SCREEN
   ============================================================ */
#screen-boot { justify-content: center; align-items: center; background: radial-gradient(ellipse at center, #0d0d1a 0%, #050508 100%); }
.boot-container { max-width: 600px; width: 90%; text-align: center; }
.boot-title { font-size: 64px; font-weight: 900; color: var(--cyan); margin-bottom: 8px; }
.boot-subtitle { font-family: var(--font-mono); color: var(--text2); margin-bottom: 30px; font-size: 13px; }
.boot-progress { width: 100%; height: 4px; background: var(--bg3); border-radius: 2px; margin-bottom: 20px; overflow: hidden; }
.boot-progress-bar { height: 100%; width: 0; background: linear-gradient(90deg, var(--cyan), var(--magenta)); transition: width 0.4s; }
.boot-status { text-align: left; max-height: 200px; overflow-y: auto; margin-bottom: 20px; }
.boot-line { font-family: var(--font-mono); font-size: 12px; color: var(--text2); padding: 2px 0; }
.boot-line.ok { color: var(--green); }
.boot-line.warn { color: var(--gold); }
.boot-line.error { color: var(--red); }
.boot-error { color: var(--red); padding: 10px; border: 1px solid var(--red); border-radius: 4px; margin-bottom: 10px; }
.boot-actions { margin-top: 20px; }

/* ============================================================
   MENU
   ============================================================ */
#screen-menu { justify-content: center; align-items: center; background: radial-gradient(ellipse at center, #0d0d1a 0%, #050508 100%); }
.menu-container { text-align: center; max-width: 400px; width: 90%; }
.menu-title { font-size: 72px; font-weight: 900; color: var(--cyan); }
.menu-subtitle { font-family: var(--font-mono); color: var(--text2); margin-bottom: 30px; }
.ai-status { font-family: var(--font-mono); font-size: 12px; color: var(--text2); margin-bottom: 20px; padding: 6px 12px; border: 1px solid var(--border); border-radius: 4px; }
.ai-status.connected { border-color: var(--green); color: var(--green); }
.ai-status.error { border-color: var(--red); color: var(--red); }
.menu-buttons { display: flex; flex-direction: column; gap: 4px; }

/* ============================================================
   SETTINGS
   ============================================================ */
.panel-container { max-width: 700px; width: 95%; margin: 40px auto; overflow-y: auto; flex: 1; }
.panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.panel-header h2 { font-family: var(--font-display); color: var(--cyan); font-size: 22px; }
.settings-body { display: flex; flex-direction: column; gap: 16px; }
.setting-group { display: flex; flex-direction: column; gap: 6px; }
.setting-label { font-family: var(--font-mono); font-size: 12px; color: var(--text2); }
.radio-row { display: flex; gap: 20px; }
.radio-label { font-family: var(--font-mono); font-size: 13px; color: var(--text); cursor: pointer; }
.setting-actions { display: flex; gap: 10px; margin-top: 10px; }
.status-message { font-family: var(--font-mono); font-size: 12px; padding: 6px; }
.status-message.ok { color: var(--green); }
.status-message.error { color: var(--red); }

/* ============================================================
   CHARACTER CREATION
   ============================================================ */
.creation-container {
    max-width: 900px; width: 95%; margin: 20px auto; overflow-y: auto; flex: 1;
    padding-bottom: 40px;
}

/* Step indicator */
.creation-steps {
    display: flex; align-items: center; justify-content: center;
    gap: 0; margin: 16px 0 8px;
}
.step-dot {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--bg3); border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 12px; color: var(--text2);
    transition: all 0.3s;
}
.step-dot.active { border-color: var(--cyan); color: var(--cyan); background: rgba(0,240,255,0.1); }
.step-line { width: 30px; height: 2px; background: var(--border); }
.creation-step-name {
    text-align: center; font-family: var(--font-mono); color: var(--text2);
    font-size: 13px; margin-bottom: 16px;
}

.creation-step { display: none; }
.creation-step.active { display: block; }

/* Mode cards */
.mode-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
.mode-card {
    background: var(--bg2); border: 2px solid var(--border); border-radius: 8px;
    padding: 24px; text-align: center; cursor: pointer; transition: all 0.3s;
}
.mode-card:hover { border-color: var(--cyan); transform: translateY(-2px); }
.mode-icon { font-size: 36px; margin-bottom: 10px; }
.mode-name { font-family: var(--font-display); color: var(--cyan); font-size: 16px; margin-bottom: 6px; }
.mode-desc { font-size: 12px; color: var(--text2); }

/* Option cards (origins, formative, specs) */
.option-list {
    display: grid; grid-template-columns: 1fr; gap: 8px;
    max-height: 55vh; overflow-y: auto; padding-right: 4px;
}
.option-card {
    background: var(--bg2); border: 1px solid var(--border); border-radius: 6px;
    padding: 12px 16px; cursor: pointer; transition: all 0.2s;
}
.option-card:hover { border-color: var(--cyan); background: var(--bg3); }
.option-card.selected { border-color: var(--cyan); background: rgba(0,240,255,0.06); box-shadow: 0 0 12px rgba(0,240,255,0.1); }
.option-name { font-family: var(--font-display); color: var(--cyan); font-size: 14px; margin-bottom: 4px; }
.option-desc { font-size: 12px; color: var(--text2); margin-bottom: 4px; }
.option-effects { font-family: var(--font-mono); font-size: 11px; color: var(--gold); }
.option-tags { font-size: 10px; color: var(--text2); opacity: 0.6; margin-top: 2px; }
.option-equip { font-family: var(--font-mono); font-size: 11px; color: var(--green); margin-top: 2px; }

.step-desc {
    font-family: var(--font-mono); color: var(--text2); font-size: 13px;
    margin-bottom: 12px; text-align: center;
}
.step-nav { display: flex; justify-content: space-between; margin-top: 16px; gap: 10px; }

/* Preset grid */
.preset-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-height: 55vh; overflow-y: auto; }
.preset-card {
    background: var(--bg2); border: 1px solid var(--border); border-radius: 8px;
    padding: 16px; cursor: pointer; transition: all 0.3s;
}
.preset-card:hover { border-color: var(--cyan); }
.preset-card.selected { border-color: var(--cyan); background: rgba(0,240,255,0.06); box-shadow: 0 0 15px rgba(0,240,255,0.15); }
.preset-name { font-family: var(--font-display); color: var(--cyan); font-size: 14px; margin-bottom: 6px; }
.preset-desc { font-size: 12px; color: var(--text2); margin-bottom: 8px; }
.preset-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.preset-stat-item { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 12px; padding: 2px 0; }
.preset-stat-item .val { color: var(--cyan); }
.preset-diff { font-family: var(--font-mono); font-size: 12px; color: var(--gold); margin-top: 8px; }
.char-name-section { margin-top: 16px; }

/* Form */
.form-row { margin-bottom: 12px; }
.form-col { margin-bottom: 8px; }
.age-category { font-family: var(--font-mono); font-size: 12px; color: var(--gold); margin-top: 4px; }

/* Point allocation */
.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.summary-col { }
.panel-section-title {
    font-family: var(--font-display); color: var(--cyan); font-size: 13px;
    border-bottom: 1px solid var(--border); padding-bottom: 6px; margin-bottom: 10px;
}
.points-counter { color: var(--gold); font-size: 11px; }
.slider-row {
    display: flex; align-items: center; gap: 6px; padding: 4px 0;
    font-family: var(--font-mono); font-size: 13px;
}
.slider-label { width: 32px; color: var(--text2); text-align: right; }
.slider-label-wide { width: 100px; color: var(--text2); font-size: 12px; }
.slider-val { width: 24px; text-align: center; color: var(--cyan); font-weight: 600; }
.btn-inc {
    width: 24px; height: 24px; background: var(--bg3); border: 1px solid var(--border);
    color: var(--text); cursor: pointer; border-radius: 3px; font-size: 14px;
    display: flex; align-items: center; justify-content: center;
    line-height: 1;
}
.btn-inc:hover { border-color: var(--cyan); color: var(--cyan); }
.slider-desc { font-size: 11px; color: var(--text2); flex: 1; }

.char-summary {
    margin-top: 16px; padding: 12px; background: var(--bg2);
    border: 1px solid var(--border); border-radius: 6px;
}
.summary-line { font-size: 13px; padding: 2px 0; color: var(--text2); }
.summary-line b { color: var(--text); }

/* ============================================================
   SAVES
   ============================================================ */
.saves-list { display: flex; flex-direction: column; gap: 8px; }
.save-item {
    display: flex; justify-content: space-between; align-items: center;
    background: var(--bg2); border: 1px solid var(--border); border-radius: 6px;
    padding: 12px 16px; transition: border-color 0.2s;
}
.save-item:hover { border-color: var(--cyan); }
.save-name { font-family: var(--font-display); color: var(--cyan); font-size: 14px; }
.save-meta { font-family: var(--font-mono); font-size: 11px; color: var(--text2); }
.save-actions { display: flex; gap: 6px; }
.empty-state { text-align: center; color: var(--text2); padding: 40px; }

/* ============================================================
   GAME SCREEN
   ============================================================ */

/* Topbar */
.game-topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 16px; background: var(--bg2); border-bottom: 1px solid var(--border);
    flex-shrink: 0; min-height: 40px; gap: 12px;
}
.topbar-left { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.char-name { font-family: var(--font-display); color: var(--cyan); font-size: 15px; }
.char-class { font-family: var(--font-mono); color: var(--text2); font-size: 11px; }
.topbar-center {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 12px; color: var(--text2);
    flex: 1; justify-content: center; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.location-icon { flex-shrink: 0; }
.time-badge { color: var(--text2); flex-shrink: 0; }
.topbar-right { display: flex; gap: 4px; flex-shrink: 0; }
.topbar-btn {
    background: none; border: 1px solid transparent; color: var(--text2);
    padding: 4px 8px; cursor: pointer; border-radius: 4px; font-size: 16px;
    transition: all 0.2s;
}
.topbar-btn:hover { border-color: var(--cyan); color: var(--cyan); }

/* Stat bars */
.stat-bars {
    display: flex; align-items: center; gap: 12px;
    padding: 6px 16px; background: var(--bg); border-bottom: 1px solid var(--border);
    flex-shrink: 0;
}
.stat-bar-group { display: flex; align-items: center; gap: 6px; flex: 1; max-width: 280px; }
.stat-label { font-family: var(--font-mono); font-size: 11px; color: var(--text2); width: 24px; flex-shrink: 0; }
.stat-bar { flex: 1; height: 8px; background: var(--bg3); border-radius: 4px; overflow: hidden; }
.stat-bar-fill { height: 100%; border-radius: 4px; transition: width 0.5s; }
.hp-fill { background: linear-gradient(90deg, var(--red), #ff6644); }
.san-fill { background: linear-gradient(90deg, #4466ff, var(--cyan)); }
.xp-fill { background: linear-gradient(90deg, var(--magenta), #ff66cc); }
.stat-val { font-family: var(--font-mono); font-size: 11px; color: var(--text2); width: 50px; flex-shrink: 0; text-align: right; }
.stat-credits {
    font-family: var(--font-display); font-size: 14px; color: var(--gold);
    flex-shrink: 0; padding-left: 8px;
}

/* Game content */
.game-content {
    flex: 1; display: flex; overflow: hidden; position: relative;
}
.narrative-panel { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.narrative-scroll {
    flex: 1; overflow-y: auto; padding: 16px 20px;
    display: flex; flex-direction: column; gap: 12px;
}

/* Messages */
.msg { padding: 12px 16px; border-radius: 8px; animation: msgAppear 0.3s ease; line-height: 1.6; }
@keyframes msgAppear { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.msg-gm { background: var(--bg2); border-left: 3px solid var(--cyan); }
.msg-player { background: rgba(255,0,170,0.06); border-left: 3px solid var(--magenta); color: var(--text); font-style: italic; }
.msg-system { background: none; color: var(--text2); font-family: var(--font-mono); font-size: 12px; text-align: center; padding: 6px; }
.msg-dice {
    background: rgba(255,215,0,0.06); border: 1px solid rgba(255,215,0,0.2);
    font-family: var(--font-mono); font-size: 12px; padding: 10px 14px; border-radius: 6px;
}
.dice-header { color: var(--gold); font-weight: 600; margin-bottom: 4px; }
.dice-result-success { color: var(--green); }
.dice-result-failure { color: var(--red); }

.msg h3, .msg h4 { color: var(--gold); margin: 8px 0 4px; }
.msg strong { color: var(--gold); }

/* Typing indicator */
.typing-indicator { display: flex; gap: 6px; padding: 12px 16px; }
.typing-dot {
    width: 8px; height: 8px; background: var(--cyan); border-radius: 50%;
    animation: typingBounce 1.4s infinite;
}
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes typingBounce { 0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; } 40% { transform: scale(1); opacity: 1; } }

/* Side panel */
.side-panel {
    width: 300px; background: var(--bg2); border-left: 1px solid var(--border);
    display: flex; flex-direction: column; flex-shrink: 0;
    position: relative;
}
.side-panel-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px; border-bottom: 1px solid var(--border);
    font-family: var(--font-display); color: var(--cyan); font-size: 14px;
}
.btn-close { background: none; border: none; color: var(--text2); cursor: pointer; font-size: 16px; }
.btn-close:hover { color: var(--red); }
.side-panel-content { flex: 1; overflow-y: auto; padding: 12px 16px; }
.attr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-bottom: 12px; }
.attr-item { display: flex; justify-content: space-between; padding: 4px 8px; background: var(--bg3); border-radius: 3px; }
.attr-name { font-family: var(--font-mono); font-size: 12px; color: var(--text2); }
.attr-val { font-family: var(--font-mono); font-size: 12px; color: var(--cyan); font-weight: 600; }
.skill-list { display: flex; flex-direction: column; gap: 2px; }
.skill-item { display: flex; justify-content: space-between; padding: 4px 8px; }
.skill-name { font-family: var(--font-mono); font-size: 12px; color: var(--text2); }
.skill-val { font-family: var(--font-mono); font-size: 12px; color: var(--cyan); font-weight: 600; }
.quest-item { padding: 8px; background: var(--bg3); border-radius: 4px; margin-bottom: 6px; font-size: 13px; }
.quest-item.completed { opacity: 0.5; }

/* Input bar */
.input-bar {
    display: flex; gap: 8px; padding: 10px 16px;
    background: var(--bg2); border-top: 1px solid var(--border);
    flex-shrink: 0; align-items: center;
}
.player-input {
    flex: 1; background: var(--bg); border: 1px solid var(--border);
    color: var(--text); padding: 10px 14px; font-family: var(--font-body);
    font-size: 14px; border-radius: 8px;
}
.player-input:focus { outline: none; border-color: var(--cyan); }

/* Quick actions */
.quick-actions {
    display: flex; gap: 6px; padding: 6px 16px 10px;
    background: var(--bg2); flex-shrink: 0; flex-wrap: wrap;
}
.quick-btn {
    background: var(--bg3); border: 1px solid var(--border); color: var(--text2);
    padding: 4px 10px; font-size: 12px; border-radius: 12px; cursor: pointer;
    font-family: var(--font-mono); transition: all 0.2s; white-space: nowrap;
}
.quick-btn:hover { border-color: var(--cyan); color: var(--cyan); }

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 768px) {
    .boot-title, .menu-title { font-size: 42px; }
    .preset-grid { grid-template-columns: 1fr; }
    .mode-cards { grid-template-columns: 1fr; }
    .summary-grid { grid-template-columns: 1fr; }
    .game-topbar { flex-wrap: wrap; padding: 6px 10px; }
    .topbar-center { font-size: 10px; order: 3; width: 100%; justify-content: flex-start; }
    .stat-bars { flex-wrap: wrap; gap: 6px; padding: 4px 10px; }
    .stat-bar-group { max-width: none; }
    .side-panel { position: absolute; right: 0; top: 0; bottom: 0; z-index: 10; width: 280px; }
    .option-list { max-height: 45vh; }
}
