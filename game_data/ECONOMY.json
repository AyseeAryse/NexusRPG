  "glossary": [
    {
      "term": "Ресурс",
      "definition": "Товар: вода, кислород, пища, гелий-3, металл, протомолекула, AI-чипы.",
      "mechanics": "Измеряется в тоннах/кг; участвует в формулах производства и торговли."
    },
    {
      "term": "Конвой",
      "definition": "Группа транспортных судов.",
      "mechanics": "Имеет вместимость, скорость и риск нападения, который зависит от контроля над маршрутом."
    },
    {
      "term": "Валюта",
      "definition": "Денежные единицы: EarthCred, MarsDebt, Cerereum.",
      "mechanics": "Курсы меняются по биржевым индексам."
    },
    {
      "term": "Кредитный рейтинг",
      "definition": "Оценка кредитоспособности от AAA до D.",
      "mechanics": "Влияет на процентные ставки и доступность займов."
    },
    {
      "term": "Фракционный токен",
      "definition": "Блокчейн-валюта конкретной фракции.",
      "mechanics": "Используется для внутрифракционных транзакций."
    },
    {
      "term": "Контрабанда",
      "definition": "Нелегальная торговля запрещенными товарами.",
      "mechanics": "Высокая прибыль, но риск конфискации и штрафов."
    }
  ],
  "economic_mechanics": {
    "formulas": {
      "production": "P = (N × E × T) - C (где N - рабочие, E - эффективность, T - технологии, C - затраты)",
      "consumption": "C_p = B × R × L (где B - базовая потребность, R - население, L - уровень жизни)",
      "trade_income": "I = V × P × (1 - R/100) × M (где V - объём, P - цена, R - риск, M - маржа)",
      "interest_rate": "R = Base_Rate + Risk_Premium + Inflation_Rate",
      "market_volatility": "V = Historical_Volatility × Uncertainty_Factor × Event_Multiplier",
      "corporate_value": "V = Assets + (Revenue × PE_Ratio) - Liabilities"
    },
    "contraband": {
      "check": "1d20 + навык Контрабандиста vs Сложность зоны контроля (10-18)",
      "profit": "Цена × Объём × (1 + Надбавка 10-50%)",
      "penalty": "Потеря 10-30% груза при провале проверки.",
      "heat_accumulation": "Каждая операция увеличивает 'Heat' - внимание правоохранителей",
      "network_effects": "Связи в преступном мире снижают риск и увеличивают прибыль"
    },
    "taxation": {
      "income_tax": "Прогрессивная шкала от 10% до 45% в зависимости от дохода",
      "corporate_tax": "20-35% с прибыли корпораций",
      "trade_tariffs": "5-25% на импорт в зависимости от товара и происхождения",
      "luxury_tax": "Дополнительные 10-50% на предметы роскоши",
      "resource_extraction_tax": "Роялти 5-15% с добытых ресурсов"
    },
    "inflation": {
      "calculation": "Базовая инфляция 2-5% + События + Денежная политика",
      "effects": "Обесценивание накоплений, рост цен на товары",
      "hedging": "Инвестиции в недвижимость, драгметаллы, криптовалюты"
    }
  },
