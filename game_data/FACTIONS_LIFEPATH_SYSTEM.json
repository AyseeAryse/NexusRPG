  "implementation_guide": {
    "for_new_factions": {
      "step_1": "Определить category новой фракции",
      "step_2": "Автоматически применить все relationship_rules для этой категории",
      "step_3": "При необходимости добавить уникальные exceptions",
      "step_4": "Система сама сгенерирует диалоги и квесты"
    },
    "for_new_lifepath": {
      "step_1": "Добавить новое происхождение в CHARACTER_LIFEPATH",
      "step_2": "Определить его социальные tags (Corporate, Criminal, Military, etc.)",
      "step_3": "Все 140+ фракций автоматически получат корректные отношения",
      "step_4": "Уникальные случаи описать в exceptions"
    }
  },

