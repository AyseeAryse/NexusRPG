  "automatic_relationship_calculation": {
    "description": "Алгоритм автоматического определения отношений любой фракции к любому lifepath",
    "process": [
      "1. Определить категорию фракции по её description и tags",
      "2. Применить базовые модификаторы из category_rules",
      "3. Добавить специфические бонусы/штрафы из lifepath_modifiers",
      "4. Учесть региональные факторы (Mars factions + Mars origins = bonus)",
      "5. Применить идеологические конфликты (Corporate vs Anti-Corporate)",
      "6. Генерировать уникальные диалоговые опции и квесты"
    ],
    "special_modifiers": {
      "regional_bonus": {
        "description": "Бонус +5 rep для фракций и происхождений с одной планеты",
        "examples": {
          "Mars faction + ORIGIN_MARS_*": "+5 regional solidarity",
          "Luna faction + ORIGIN_LUNA_*": "+5 shared hardships",
          "Belt faction + ORIGIN_*_MINER": "+5 frontier bond"
        }
      },
      "ideological_conflict": {
        "description": "Конфликты мировоззрений дают штрафы",
        "examples": {
          "Corporate faction + Anti-Corporate origin": "-10 ideological opposition",
          "Military faction + Pacifist origin": "-5 philosophical difference",
          "Religious faction + Atheist scientist": "-5 worldview clash"
        }
      }
    }
  },

