{
  "module_name": "POLITICS",
  "description": "Полное описание модуля политических систем и пропаганды, включающее правила, глоссарий, структуры правительств, систему влияния, пропаганду, генераторы событий, роли игроков и шаблоны миссий.",
  "glossary": [
    {
      "term": "Мандат",
      "definition": "Формальная директива власти к подчинённым фракциям.",
      "game_effect": "Глобальный бонус/штраф (например, ±X к производству ресурсов).",
      "example": "ООН Земли принимает мандат «Жёсткая блокада»: –20% к торговле на 3 хода."
    },
    {
      "term": "Санкции",
      "definition": "Экономические или политические ограничения против фракции.",
      "game_effect": "–X% к экономике, –Y к лояльности.",
      "example": "Марсианская Республика накладывает санкции на TerraForm Union."
    },
    {
      "term": "Подпольные Каналы",
      "definition": "Нелегальные сети коммуникации и распространения информации.",
      "game_effect": "Игнорирование штрафов к скрытности при проведении информационных операций.",
      "example": "Shadow Corsairs запускают кампанию дезинформации через подпольные каналы."
    },
    {
      "term": "PR-кампания",
      "definition": "Официальная медийная активность для формирования общественного мнения.",
      "game_effect": "+X к лояльности или репутации фракции.",
      "example": "TerraForm Union проводит «зелёную» PR-кампанию: +10% к репутации у населения Земли."
    },
    {
      "term": "Инфовойна",
      "definition": "Борьба за информационное превосходство с использованием фейков, взломов и пропаганды.",
      "game_effect": "–X к репутации или лояльности оппонента.",
      "example": "ByteHack Collective запускает фейк-новость о провале OPA."
    }
  ],
  "government_types": [
    {
      "id": "centralized_state",
      "name": "Централизованные государства (Империи/Диктатуры)",
      "bonuses": [
        "+X к Силе Флота",
        "+Y к Контрразведке"
      ],
      "penalties": [
        "–X к Лояльности в периферийных системах",
        "Уязвимость к Идеологическому Вакууму"
      ],
      "mechanics": [
        {
          "name": "Мандаты",
          "description": "Возможность издавать директивы с глобальными модификаторами (например, 'Мандат жёсткой обороны': +5 к защите всех флотилий на 3 хода)."
        }
      ]
    },
    {
      "id": "federation",
      "name": "Федерации и конгломерации (Демократии/Альянсы)",
      "bonuses": [
        "+X к Экономике",
        "+Y к Технологическим Исследованиям"
      ],
      "penalties": [
        "Замедленное реагирование на кризисы",
        "Уязвимость к санкциям и коррупции"
      ],
      "mechanics": [
        {
          "name": "Процедуры Согласования",
          "description": "Решения вступают в силу через 1–3 игровых хода после голосования."
        }
      ]
    },
    {
      "id": "corporatocracy",
      "name": "Корпоративные республики (Плутократии)",
      "bonuses": [
        "+X к Производству",
        "+Y к Корпоративному PR"
      ],
      "penalties": [
        "Высокий базовый уровень Недовольства",
        "Уязвимость к Подпольным Сетям"
      ],
      "mechanics": [
        {
          "name": "Рейтинг корпоративной ответственности",
          "description": "Заменяет общую Лояльность населения, изменяется PR-ходами и кризисами."
        }
      ]
    },
    {
      "id": "separatist_enclave",
      "name": "Сепаратистские анклавы (Независимые/Пиратские)",
      "bonuses": [
        "Высокая конспиративность",
        "Доступ к Чёрному рынку"
      ],
      "penalties": [
        "–X к Силе Флота",
        "Ограниченные ресурсы"
      ],
      "mechanics": [
        {
          "name": "Скрытые Базы",
          "description": "Сложность обнаружения баз и операций +5 ко всем проверкам разведки противника."
        }
      ]
    }
  ],
