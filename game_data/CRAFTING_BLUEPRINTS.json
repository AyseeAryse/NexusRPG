{
  "module_name": "CRAFTING_BLUEPRINTS_COMPLETE_OPTIMIZED",
  "description": "Полная система создания и модификации предметов с детальными чертежами, ресурсами, механиками и интеграцией с жизненным путем.",
  "version": "2.0_COMPLETE_OPTIMIZED",
  "system_overview": {
    "purpose": "Создание и модификация предметов через систему ремесла",
    "scope": "Чертежи, ресурсы, навыковые требования, механики успеха/неудачи, модификации",
    "integration": "Создает предметы из TECH_EQUIPMENT_COMPLETE_OPTIMIZED",
    "complexity": "Многоуровневая система от простых инструментов до экзотических артефактов"
  },
  "crafting_mechanics": {
    "success_calculation": {
      "formula": "Skill_Level + Tech_Knowledge + Equipment_Bonus + d20 vs Difficulty",
      "modifiers": {
        "lifepath_bonus": "Origin и Specialization могут давать +1 до +3",
        "workshop_bonus": "Качество мастерской: +0 до +5",
        "assistant_bonus": "Помощники: +1 за каждого (максимум +3)",
        "time_bonus": "+1 за каждые дополнительные 50% времени"
      },
      "critical_success": "Nat 20: +25% к характеристикам предмета, экономия 20% материалов",
      "critical_failure": "Nat 1: Потеря 75% материалов, 2d6 урона, возможно внимание враждебных фракций"
    },
    "difficulty_scale": {
      "trivial": "DC 5 - Простой ремонт, базовые инструменты",
      "easy": "DC 8 - Стандартное снаряжение, известные технологии",
      "medium": "DC 12 - Продвинутое оборудование, специализированные детали",
      "hard": "DC 16 - Военные технологии, редкие материалы",
      "very_hard": "DC 20 - Экспериментальные устройства, экзотические ресурсы",
      "extreme": "DC 25 - Артефакты, неизученные технологии"
    },
    "time_requirements": {
      "simple_items": "2-6 часов (инструменты, простое оружие)",
      "complex_items": "1-3 дня (продвинутое снаряжение, импланты)",
      "legendary_items": "1-2 недели (силовая броня, экзотические устройства)",
      "artifacts": "1-6 месяцев (артефакты, революционные технологии)"
    },
    "failure_consequences": {
      "minor_failure": {
        "description": "Неудача на 1-5 пунктов",
        "effects": "Потеря 25% материалов, удвоенное время"
      },
      "major_failure": {
        "description": "Неудача на 6-10 пунктов",
        "effects": "Потеря 50% материалов, 1d6 урона, испорченное оборудование"
      },
      "critical_failure": {
        "description": "Неудача на 11+ пунктов или Nat 1",
        "effects": "Потеря всех материалов, 2d6 урона, взрыв/пожар, внимание властей"
      },
      "catastrophic_failure": {
        "description": "Критическая неудача при создании артефактов",
        "effects": "Разрушение мастерской, 4d6 урона, аномальные эффекты, расследование"
      }
    }
  },
