{
  "module_name": "CHARACTER_CREATION_V2",
  "version": "2.0_EXPANDED",
  "description": "Расширенная система создания персонажа с именем, возрастом и профессиями",
  "replaces": "STARTGAME процедуры с обязательными именем и возрастом",
  "mandatory_fields": {
    "character_name": {
      "required": true,
      "prompt": "Как зовут вашего персонажа?",
      "validation": "Не менее 2 символов, без цифр"
    },
    "character_age": {
      "required": true,
      "prompt": "Сколько лет вашему персонажу?",
      "range": [
        16,
        80
      ],
      "age_effects": {
        "young_16_25": {
          "bonus": "+1 Agility, +1 Endurance",
          "penalty": "-1 Wisdom"
        },
        "adult_26_45": {
          "bonus": "Balanced stats",
          "penalty": "None"
        },
        "mature_46_65": {
          "bonus": "+1 Intelligence, +1 Wisdom",
          "penalty": "-1 Agility"
        },
        "elder_66_80": {
          "bonus": "+2 Wisdom, +1 Intelligence",
          "penalty": "-2 Endurance"
        }
      }
    }
  },
