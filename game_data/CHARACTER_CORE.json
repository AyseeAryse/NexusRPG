  "character_creation": {
    "step_1": "Choose Origin from CHARACTER_LIFEPATH.json",
    "step_2": "Choose Formative Years events",
    "step_3": "Choose Specialization",
    "step_4": "Apply lifepath bonuses via conversion table",
    "step_5": "Finalize base stats and derived values",
    "workflow": [
      "ApplyLifepathModifiers(originModifiers, formativeModifiers, specModifiers)",
      "CalculateDerivedStats()",
      "Finalize character state"
    ]
  },
