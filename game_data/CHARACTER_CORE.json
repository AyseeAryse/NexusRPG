  "character_validation": {
    "required_fields": [
      "name",
      "origin",
      "formative_years",
      "specialization"
    ],
    "stat_limits": {
      "no_attribute_below_1": true,
      "no_skill_above_10": true,
      "total_skill_points_limit": 50
    },
    "lifepath_consistency": {
      "description": "Проверка соответствия выбранных lifepath-элементов",
      "rules": [
        "context_tags должны соответствовать между origin и formative_years",
        "specialization должна иметь логическую связь с предыдущими выборами"
      ]
    }
  },
  "api_integration": {
    "description": "API для интеграции с другими модулями системы",
    "functions": [
      {
        "name": "ApplyLifepathModifiers",
        "description": "Объединяет модификаторы происхождения, событий и специализаций и обновляет атрибуты/навыки/ресурсы."
      },
      {
        "name": "CalculateDerivedStats",
        "description": "Пересчитывает HP, Sanity, Initiative, Defense на основе текущих атрибутов и навыков."
      },
      {
        "name": "UpdateResource",
        "description": "Изменяет значения credits, heat, reputation, influence, debt."
      },
      {
        "name": "GetCharacterState",
        "description": "Возвращает полный объект персонажа для других модулей."
      },
      {
        "name": "ValidateCharacter",
        "description": "Проверяет корректность созданного персонажа согласно правилам валидации."
      }
    ],
    "hooks": [
      "OnOriginApplied",
      "OnFormativeEventApplied",
      "OnSpecializationApplied",
      "OnCharacterFinalized"
    ]
  }
