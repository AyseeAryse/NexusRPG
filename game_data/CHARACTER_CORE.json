    "automatic_bonus_application": {
      "description": "При создании персонажа автоматически применяются бонусы из lifepath",
      "examples": {
        "ORIGIN_MARS_SCIENTIST": {
          "input_effects": [
            "+2 Наука",
            "+1 Инженерия",
            "−1 Харизма"
          ],
          "converted_effects": [
            "+2 technology",
            "+1 engineering",
            "−1 charisma"
          ],
          "result": "technology: 3, engineering: 2, charisma: 4"
        },
        "ORIGIN_EARTH_ELITE": {
          "input_effects": [
            "+2 Образование",
            "+1 Дипломатия",
            "−1 Выживание"
          ],
          "converted_effects": [
            "+2 education",
            "+1 diplomacy",
            "−1 survival"
          ],
          "result": "education: 3, diplomacy: 2, survival: 0"
        }
      }
    },
    "trait_application": {
      "description": "Пассивные трейты из CHARACTER_LIFEPATH автоматически добавляются в traits[]",
